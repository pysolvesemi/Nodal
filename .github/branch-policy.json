{
  "schema": 1,
  "strategy": "protected-integration-and-release",
  "development_branch": "dev",
  "release_branch": "main",
  "feature_branch_pattern": "increment/<number>-<slug>",
  "repository_default_branch_after_bootstrap": "dev",
  "branches": {
    "dev": {
      "role": "integration",
      "direct_push": false,
      "force_push": false,
      "deletion": false,
      "pull_request_required": true,
      "required_status_check": "Core CI / required",
      "require_conversation_resolution": true,
      "normal_merge_method": "squash",
      "normal_source_pattern": "increment/**"
    },
    "main": {
      "role": "milestone-release",
      "direct_push": false,
      "force_push": false,
      "deletion": false,
      "pull_request_required": true,
      "required_status_check": "Core CI / required",
      "require_conversation_resolution": true,
      "allowed_source_branch": "dev",
      "merge_method": "merge",
      "release_gate": "completed roadmap milestone plus annotated or signed tag"
    }
  },
  "bootstrap": {
    "when": "after Increment 8 is checked and the full Core CI gate succeeds",
    "method": "direct-ref",
    "create_dev_from": "increment/8-ci-baseline",
    "require_identical_tree": true,
    "bootstrap_pull_request_required": false,
    "reason": "Create dev at the exact validated Increment 8 head. The increment stack is linear, so this preserves every independently validated commit without adding an artificial bootstrap merge commit."
  },
  "milestone_promotions": {
    "M0": "after Increment 15",
    "M1": "after Increment 26",
    "M2": "after Increment 53",
    "M3": "after Increment 78",
    "M4": "after Increment 94",
    "M5": "after Increment 104"
  }
}
