+// Instance signatures must substitute inside the capability wrapper, retaining
+// its electrical identity and rejecting absent bindings rather than defaults.
+TEST(TypesTest, EvaluateParametricInOut) {
+  MLIRContext context;
+  context.loadDialect<HWDialect>();
+  Builder builder(&context);
+  auto formal =
+      ParamDeclRefAttr::get(builder.getStringAttr("W"), builder.getI32Type());
+  auto actual =
+      ParamDeclRefAttr::get(builder.getStringAttr("P"), builder.getI32Type());
+  auto type = InOutType::get(IntType::get(formal));
+  auto parameters = builder.getArrayAttr(
+      {ParamDeclAttr::get(builder.getStringAttr("W"), actual)});
+  auto result =
+      evaluateParametricType(builder.getUnknownLoc(), parameters, type);
+  ASSERT_TRUE(succeeded(result));
+  EXPECT_EQ(*result, InOutType::get(IntType::get(actual)));
+  EXPECT_TRUE(isParametricType(type));
+  EXPECT_TRUE(isParametricType(*result));
+  EXPECT_TRUE(failed(evaluateParametricType(builder.getUnknownLoc(),
+                                            builder.getArrayAttr({}), type,
+                                            /*emitErrors=*/false)));
+  auto concrete = builder.getArrayAttr({ParamDeclAttr::get(
+      builder.getStringAttr("W"), builder.getI32IntegerAttr(7))});
+  result = evaluateParametricType(builder.getUnknownLoc(), concrete, type);
+  ASSERT_TRUE(succeeded(result));
+  EXPECT_EQ(*result, InOutType::get(builder.getIntegerType(7)));
+  EXPECT_FALSE(isParametricType(*result));
+}
+
+TEST(TypesTest, EvaluateParametricInOutArrayElements) {
+  MLIRContext context;
+  context.loadDialect<HWDialect>();
+  Builder builder(&context);
+  auto formal =
+      ParamDeclRefAttr::get(builder.getStringAttr("W"), builder.getI32Type());
+  auto parameters = builder.getArrayAttr({ParamDeclAttr::get(
+      builder.getStringAttr("W"), builder.getI32IntegerAttr(7))});
+  auto packed = InOutType::get(ArrayType::get(IntType::get(formal), 3));
+  auto unpacked =
+      InOutType::get(UnpackedArrayType::get(IntType::get(formal), 2));
+  auto packedResult =
+      evaluateParametricType(builder.getUnknownLoc(), parameters, packed);
+  auto unpackedResult =
+      evaluateParametricType(builder.getUnknownLoc(), parameters, unpacked);
+  ASSERT_TRUE(succeeded(packedResult));
+  ASSERT_TRUE(succeeded(unpackedResult));
+  EXPECT_TRUE(isParametricType(packed));
+  EXPECT_TRUE(isParametricType(unpacked));
+  EXPECT_EQ(*packedResult,
+            InOutType::get(ArrayType::get(builder.getIntegerType(7), 3)));
+  EXPECT_EQ(*unpackedResult, InOutType::get(UnpackedArrayType::get(
+                                 builder.getIntegerType(7), 2)));
+}
