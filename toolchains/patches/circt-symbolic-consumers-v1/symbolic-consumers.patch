+// Preserve parameter expressions instead of assuming every HW integer has a
+// concrete width. The HW parameter owner performs canonical width addition.
+static Type getConcatType(MLIRContext *context, ValueRange inputs) {
+  auto widthType = IntegerType::get(context, 32);
+  SmallVector<TypedAttr> widths;
+  for (Value input : inputs) {
+    if (auto integer = hw::type_dyn_cast<IntegerType>(input.getType()))
+      widths.push_back(IntegerAttr::get(widthType, integer.getWidth()));
+    else if (auto integer = hw::type_dyn_cast<hw::IntType>(input.getType()))
+      widths.push_back(integer.getWidth());
+    else
+      return {};
+  }
+  if (widths.empty())
+    return IntegerType::get(context, 0);
+  return hw::IntType::get(hw::ParamExprAttr::get(hw::PEO::Add, widths));
 }
 
