//| mill-version: 1.1.7
//| mill-jvm-version: zulu:25

package build

import mill.*
import mill.api.BuildCtx
import mill.javalib.JavaModule
import mill.scalalib.*
import mill.util.Jvm

object Versions:
  val scala3 = "3.8.4"
  val scalafix = "0.14.7"

trait NodalScalaModule extends ScalaModule:
  def scalaVersion = Versions.scala3

  def scalacOptions = Seq(
    "-deprecation",
    "-feature",
    "-unchecked",
    "-Wunused:all",
    "-Werror",
  )

object scalafix extends JavaModule:
  def scalafixClasspath: T[Seq[PathRef]] = Task {
    defaultResolver().classpath(
      Seq(mvn"ch.epfl.scala:scalafix-cli_3.8.4:${Versions.scalafix}")
    )
  }

  private def scalafixArguments(checkOnly: Boolean): Seq[String] =
    Seq(
      "--config",
      ".scalafix.conf",
      "--scala-version",
      Versions.scala3,
      "--syntactic",
    ) ++ (if checkOnly then Seq("--check") else Seq.empty) ++ Seq(
      "core/scala",
      "core/integrations",
      "examples",
    )

  private def invoke(
      checkOnly: Boolean,
      classPath: Seq[PathRef],
  )(using mill.api.TaskCtx): Unit =
    Jvm.callProcess(
      "scalafix.cli.Cli",
      scalafixArguments(checkOnly),
      classPath = classPath.map(_.path),
      cwd = BuildCtx.workspaceRoot,
      stdin = os.Inherit,
      stdout = os.Inherit,
    )

  def check(): Command[Unit] = Task.Command {
    invoke(
      checkOnly = true,
      classPath = scalafixClasspath(),
    )
  }

  def fix(): Command[Unit] = Task.Command {
    invoke(
      checkOnly = false,
      classPath = scalafixClasspath(),
    )
  }

object core extends Module:
  object integrations extends NodalScalaModule

  object scala extends Module:
    object api extends NodalScalaModule

    object frontend extends NodalScalaModule:
      def moduleDeps = Seq(api)

    object bridge extends NodalScalaModule:
      def moduleDeps = Seq(frontend, api)

    object sim extends NodalScalaModule:
      def moduleDeps = Seq(bridge, api, core.integrations)

    object cli extends NodalScalaModule:
      def moduleDeps = Seq(sim, bridge, frontend, api)

    object testkit extends NodalScalaModule:
      def moduleDeps = Seq(cli, sim, bridge, frontend, api)

      object test extends ScalaTests:
        def mvnDeps = Seq(mvn"com.lihaoyi::utest:0.9.1")
        def testFramework = "utest.runner.Framework"

object examples extends Module:
  object externalLibrary extends NodalScalaModule:
    def moduleDeps = Seq(core.scala.api)

  object publicApiCandidates extends NodalScalaModule:
    def moduleDeps = Seq(core.scala.api, externalLibrary)

  object clockResetApi extends NodalScalaModule:
    def moduleDeps = Seq(core.scala.api, externalLibrary)
