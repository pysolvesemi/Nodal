#!/usr/bin/env python3
from __future__ import annotations

from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
REVISION = "increment35-bootstrap-v1"
STAMP = ROOT / "tests/compiler/fixtures/increment35/bootstrap-revision.txt"


def read(relative: str) -> str:
    path = ROOT / relative
    if not path.is_file():
        raise RuntimeError(f"missing required file: {relative}")
    return path.read_text(encoding="utf-8")


def write(relative: str, content: str) -> None:
    path = ROOT / relative
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content, encoding="utf-8")


def replace_once(relative: str, old: str, new: str) -> None:
    path = ROOT / relative
    text = read(relative)
    count = text.count(old)
    if count != 1:
        raise RuntimeError(
            f"{relative}: expected one replacement anchor, found {count}\n--- anchor ---\n{old}"
        )
    path.write_text(text.replace(old, new), encoding="utf-8")


def main() -> None:
    if STAMP.is_file() and STAMP.read_text(encoding="utf-8").strip() == REVISION:
        return

    replace_once(
        "core/scala/api/src/nodal/CandidateApi.scala",
