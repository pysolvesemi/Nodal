  CandidateRuntime.continuousOperator("analog_idt", value, None)

def idt(value: Expr[Real], initialValue: Expr[Real]): Expr[Real] =
  CandidateRuntime.continuousOperator("analog_idt", value, Some(initialValue))
''',
    )
