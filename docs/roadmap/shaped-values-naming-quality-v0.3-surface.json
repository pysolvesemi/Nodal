      "index",
      "row or plane view",
      "slice",
      "flatten",
      "reshape",
      "map",
      "zip",
      "reduce"
    ],
    "shape_connection": "exact-or-explicit-adapter"
  },
  "storage": {
    "Vec": "structural value collection",
    "Mem": "addressable storage with explicit latency collision ports domain and initialization",
    "unpacked_syntax_implies_memory": false,
    "dynamic_vec_index_implies_memory": false,
    "unexpected_structural_memory_inference_audited": true,
    "resource_mapping_requires_declared_effect_and_proof": true
  },
  "layouts": {
    "candidates": [
