{
  "schema": 1,
  "version": "0.1",
  "status": "frozen",
  "default_import": "nodal.*",
  "source_compatibility": "0.1.x",
  "binary_compatibility": "not-guaranteed-before-v1",
  "backend_entry_point": {
    "owner": "nodal.Nodal",
    "method": "emit(top: => Module, backend: Backend, outputDirectory: java.nio.file.Path): Unit",
    "backends": [
      "Backend.VerilogA",
      "Backend.VerilogAMS"
    ]
  },
  "parameterized_hdl": {
    "preserve_by_default": true,
    "module_parameter": "param(default: Expr[A]): Param[A]",
    "integer_widths": [
      "Bits(width: Expr[Integer])",
      "UInt(width: Expr[Integer])"
    ],
    "instance_override": "Instance.param(select: M => Param[A], value: Expr[A])",
    "verilog_emission": "parameter declarations plus named instance overrides",
    "specialize_modules_by_default": false,
    "scala_constructor_arguments_are_hdl_parameters": false
  },
